            *)
                [[ "$(docker_network_menu "$(docker_list_name "$chosen")")" == "$doexit" ]] && { echo "$doexit"; return 0; }
                ;;
        esac
    done
}

docker_prune() {
    local what="$1"; shift
    docker_confirm "Prune $what?" || return 0
    (
        if out=$("$@" 2>&1); then
            docker_notify "Pruned $what: $(printf '%s\n' "$out" | grep -i 'reclaimed' | tail -1)"
        else
            docker_notify "$out"
        fi
    ) >/dev/null 2>&1 &
    disown
}

docker_disk_menu() {
    local prune_containers="Prune stopped containers"
    local prune_dangling="Prune dangling images"
    local prune_images="Prune all unused images"
    local prune_cache="Prune build cache"
    local prune_volumes="Prune unused volumes"
    while true; do
        local usage
        usage="$(docker system df --format '{{.Type}}: {{.Size}}, reclaimable {{.Reclaimable}}')"
        usage="${usage//$'\n'/\\n}"

        local options="$usage\n$divider\n$prune_containers\n$prune_dangling\n$prune_images\n$prune_cache\n$prune_volumes\n$divider\n$goback\n$doexit"
        local chosen
        chosen="$(qs_menu "Disk usage" "$options")"
        case $chosen in
            "$divider") ;;
            "$goback") echo "$goback"; return 0 ;;
            "" | "$doexit") echo "$doexit"; return 0 ;;
            "$prune_containers") docker_prune "stopped containers" docker container prune -f ;;
            "$prune_dangling") docker_prune "dangling images" docker image prune -f ;;
            "$prune_images") docker_prune "all unused images" docker image prune -a -f ;;
            "$prune_cache") docker_prune "build cache" docker builder prune -a -f ;;
            "$prune_volumes") docker_prune "unused volumes" docker volume prune -a -f ;;
            *) ;;
        esac
    done
}

docker_menu() {
    local sub_options="$divider"
    case $1 in
        -s | --sub-command) sub_options="$sub_options\n$goback\n$doexit" ;;
        *) sub_options="$sub_options\n$doexit" ;;
    esac

    while true; do
        local options counts=""
        if docker_service_running; then
            local running total
            running=$(docker ps -q | wc -l)
            total=$(docker ps -aq | wc -l)
            counts="$docker_containers_label ($running/$total running)"
            options="$docker_stop_label\n$divider\n$counts\n$docker_compose_label\n$docker_images_label\n$docker_volumes_label\n$docker_networks_label\n$docker_disk_label"
        else
            options="$docker_start_label"
        fi

        local chosen ret=""
        chosen="$(qs_menu "Docker" "$options\n$sub_options")"
        case $chosen in
            "$divider") ;;
            "$goback") echo "$goback"; return 0 ;;
            "" | "$doexit") echo "$doexit"; return 0 ;;
            "$docker_start_label") docker_service_start ;;
            "$docker_stop_label") docker_confirm "Stop Docker and all containers?" && docker_service_stop ;;
            "$counts") ret=$(docker_containers_menu) ;;
            "$docker_compose_label") ret=$(docker_compose_menu) ;;
            "$docker_images_label") ret=$(docker_images_menu) ;;
            "$docker_volumes_label") ret=$(docker_volumes_menu) ;;
            "$docker_networks_label") ret=$(docker_networks_menu) ;;
            "$docker_disk_label") ret=$(docker_disk_menu) ;;
        esac
        [[ "$ret" == "$doexit" ]] && { echo "$doexit"; return 0; }
    done
}
