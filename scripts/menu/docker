docker_network_menu() {
    local name="$1"
    while true; do
        local info
        info="$(docker network inspect -f '{{.Driver}}|{{range .IPAM.Config}}{{.Subnet}} {{end}}|{{range .IPAM.Config}}{{.Gateway}} {{end}}|{{range .Containers}}{{.Name}},{{end}}' "$name" 2>/dev/null)"
        [[ -z "$info" ]] && { echo "$goback"; return 0; }
        local driver subnet gateway users
        IFS='|' read -r driver subnet gateway users <<< "$info"

        local options=""
        [[ "$name" != bridge && "$name" != host && "$name" != none ]] && options="Delete\n$divider\n"
        options="${options}Name: $name\nDriver: $driver"
        [[ -n "${subnet// }" ]] && options="$options\nSubnet: ${subnet% }"
        [[ -n "${gateway// }" ]] && options="$options\nGateway: ${gateway% }"
        options="$options\nContainers: ${users%,}"
        [[ -z "$users" ]] && options="${options}none"
        options="$options\n$divider\n$goback\n$doexit"

        local chosen
        chosen="$(qs_menu "Network: $name" "$options")"
        case $chosen in
            "$divider") ;;
            "$goback") echo "$goback"; return 0 ;;
            "" | "$doexit") echo "$doexit"; return 0 ;;
            Delete) docker_confirm "Delete network $name?" && { docker_try docker network rm "$name"; echo "$goback"; return 0; } ;;
            *) docker_copy_info "$chosen" ;;
        esac
    done
}

