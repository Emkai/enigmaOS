#!/usr/bin/env bash

# Quickshell-backed picker used by every menu in this directory, rendered by
# the qsmenu quickshell config (configs/quickshell). Replaced the old wofi
# picker (scripts/menu/wofi) with the same contract.

# Constants
divider="---------"
doexit="Exit"
goback="Back"

QSMENU_CONFIG_DIR="$HOME/.config/quickshell/qsmenu"

qsmenu_ipc() {
    qs -p "$QSMENU_CONFIG_DIR" ipc call menu "$@"
}

qsmenu_ensure_daemon() {
    qsmenu_ipc echo ok >/dev/null 2>&1 && return 0
    qs -p "$QSMENU_CONFIG_DIR" -d >/dev/null 2>&1
    for _ in $(seq 1 50); do
        sleep 0.1
        qsmenu_ipc echo ok >/dev/null 2>&1 && return 0
    done
    notify-send "qsmenu" "quickshell daemon did not come up"
    return 1
}

# $1 prompt, $2 options ('\n'-separated, echo -e style escapes), $3 optional
# line-count override; honors the callers' $max_lines. Prints the selection,
# the typed text when nothing matched, or nothing when dismissed.
qs_menu() {
    local prompt=$1
    local options
    options=$(printf '%b' "$2")

    local nr_options
    if [[ -z $3 ]]; then
        nr_options=$(printf '%s\n' "$options" | wc -l)
        if [[ -n $max_lines ]] && (( nr_options > max_lines )); then
            nr_options=$max_lines
        fi
    else
        nr_options=$3
    fi

    qsmenu_ensure_daemon || return 1

    local fifo
    fifo=$(mktemp -u "${XDG_RUNTIME_DIR:-/tmp}/qsmenu-XXXXXX")
    mkfifo -m 600 "$fifo" || return 1

    if ! qsmenu_ipc open "$prompt" "$options" "$fifo" "$nr_options" "${QSMENU_PASSWORD:-false}" >/dev/null 2>&1; then
        rm -f "$fifo"
        return 1
    fi

    # Open read-write so neither side can hang forever on a vanished peer.
    local chosen="" fd
    exec {fd}<>"$fifo"
    IFS= read -r -t 3600 -u "$fd" chosen
    exec {fd}<&-
    rm -f "$fifo"
    printf '%s\n' "$chosen"
}

# Masked free-text prompt (passwords): $1 prompt. Prints the typed text,
# nothing when dismissed.
qs_menu_password() {
    QSMENU_PASSWORD=true qs_menu "$1" "" 0
}
