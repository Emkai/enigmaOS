#!/usr/bin/env bash

# Main menu launcher (super+alt+L). The menus live in scripts/menu/* and are
# rendered by the qsmenu quickshell config (configs/quickshell) via the
# qs_menu picker in scripts/menu/qsmenu.

SCRIPT_DIR="$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"

source "$SCRIPT_DIR/menu/main"

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main_menu "$@"
fi
